# --- Functions ---

#
# SSH Agent
#
# Start ssh agent and source environment
function start_ssh_agent {
  echo "Initialising new SSH agent..."
  /usr/bin/ssh-agent -t ${SSH_KEY_LIFETIME} | sed 's/^echo/#echo/' > "${SSH_ENV}"
  chmod 600 "${SSH_ENV}"
  source "${SSH_ENV}" > /dev/null
}

# Source SSH settings, if applicable
function load_ssh_agent {
  if [ -z "$XDG_CURRENT_DESKTOP" ]; then
    if [ -f "${SSH_ENV}" ]; then
      source "${SSH_ENV}" > /dev/null
      #ps ${SSH_AGENT_PID} doesn't work under cywgin
      ps -ef | grep ${SSH_AGENT_PID} | grep "ssh-agent -t ${SSH_KEY_LIFETIME}$" > /dev/null || {
        start_ssh_agent;
      }
    else
      start_ssh_agent;
    fi
  fi
}

#
# Helper functions
# Check if the directory is a windows mounted drive
isWinDir() {
  if [[ -v WSL_DISTRO_NAME ]] && [[ $PWD =~ "^/mnt/(c|d)/" ]]; then
    return $(true)
  fi

  return $(false)
}

# Manage the dotfiles, a function so reload runs in the current shell
dotfiles() {
  case "$1" in
  update)
    # Load the script into memory first, git pull may rewrite it while it runs
    DOTFILES_UPDATE=1 bash -c "$(cat "$HOME/dotfiles/install.sh")" && dotfiles reload
    ;;
  reload)
    source "$HOME/.zshenv" && source "$HOME/.zshrc"
    ;;
  *)
    echo "Usage: dotfiles <command>"
    echo
    echo "Commands:"
    echo "  update  Re-run install.sh to pull the dotfiles and update packages and tools"
    echo "  reload  Reload .zshenv and .zshrc in the current shell"
    return 1
    ;;
  esac
}

# Include optional files
include() {
  [[ -f "$1" ]] && source "$1"
}

# Include the local functions
include ~/.functions.local
