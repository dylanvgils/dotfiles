#compdef dotfiles

_dotfiles() {
  local -a commands

  commands=(
    'stow:Re-create the symlinks (e.g. for new files) and reload the shell'
    'update:Re-run install.sh to pull the dotfiles and update packages and tools'
    'reload:Reload .zshenv and .zshrc in the current shell'
  )

  # -V keeps the order above instead of sorting
  _describe -V 'command' commands
}

_dotfiles "$@"
